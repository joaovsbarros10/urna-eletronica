%% Casos de uso (seção 5.1). Mermaid não tem diagrama de casos de uso nativo;
%% este fluxograma usa elipses para os casos e setas tracejadas para include/extend.
flowchart LR
    eleitor(["👤 Eleitor"])
    administrador(["👤 Administrador"])

    subgraph urna["Urna eletrônica"]
        digitar(("Digitar número"))
        consultar(("Consultar candidato<br/>e partido"))
        branco(("Votar em branco"))
        corrigir(("Corrigir voto"))
        confirmar(("Confirmar voto"))
        finalizar(("Finalizar votação<br/>e gravar votos"))
        partidos(("Gerenciar partidos"))
        candidatos(("Gerenciar candidatos"))
        validar(("Validar número<br/>do candidato"))
        apurar(("Apurar votos<br/>por cargo"))
    end

    eleitor --- digitar
    eleitor --- branco
    eleitor --- corrigir
    eleitor --- confirmar
    digitar -. "«include»" .-> consultar
    finalizar -. "«extend» (último cargo)" .-> confirmar

    administrador --- partidos
    administrador --- candidatos
    administrador --- apurar
    candidatos -. "«include»" .-> validar
