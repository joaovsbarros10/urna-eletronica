%% Partido, Cargo e a hierarquia de Candidato (seção 5.3.1), conforme o código.
classDiagram
    direction TB

    class Cargo {
        <<enumeration>>
        PRESIDENTE
        GOVERNADOR
        SENADOR
        DEPUTADOFEDERAL
        DEPUTADOESTADUAL
        -int quantidadeDigitos
        -String descricao
        -int ordemDeVotacao
        +getQuantidadeDigitos() int
        +getDescricao() String
        +getOrdemDeVotacao() int
        +possuiVice() boolean
        +possuiSuplentes() boolean
        +listarEmOrdemDeVotacao()$ List~Cargo~
    }

    class Partido {
        +int QUANTIDADEDIGITOS$
        -long identificador
        -int numero
        -String sigla
        -String nome
        +Partido(long identificador, int numero, String sigla, String nome)
        +getIdentificador() long
        +getNumero() int
        +getSigla() String
        +getNome() String
        +correspondeAoPrefixo(String numeroCandidato) boolean
    }

    class Candidato {
        <<abstract>>
        -long identificador
        -String nome
        -String numero
        -Partido partido
        -byte[] foto
        #Candidato(FichaCandidato ficha)
        +getIdentificador() long
        +getNome() String
        +getNumero() String
        +getPartido() Partido
        +getFoto() byte[]
        +getCargo()* Cargo
        +obterLinhasAdicionais()* List~String~
        +validarNumero() void
        +gerarFicha() FichaCandidato
        #completarFicha(Montador montador) void
        #exigirTexto(String valor, String descricao)$ String
    }

    class CandidatoComVice {
        <<abstract>>
        -String nomeVice
        +getNomeVice() String
        +obterLinhasAdicionais() List~String~
        #obterRotuloDoVice()* String
        #completarFicha(Montador montador) void
    }

    class CandidatoPresidente {
        +getCargo() Cargo
        #obterRotuloDoVice() String
    }

    class CandidatoGovernador {
        +getCargo() Cargo
        #obterRotuloDoVice() String
    }

    class CandidatoSenador {
        -String nomePrimeiroSuplente
        -String nomeSegundoSuplente
        +getCargo() Cargo
        +obterLinhasAdicionais() List~String~
        #completarFicha(Montador montador) void
    }

    class CandidatoDeputado {
        <<abstract>>
        +obterLinhasAdicionais() List~String~
    }

    class CandidatoDeputadoFederal {
        +getCargo() Cargo
    }

    class CandidatoDeputadoEstadual {
        +getCargo() Cargo
    }

    class FichaCandidato {
        <<imutavel>>
        -Cargo cargo
        -long identificador
        -String nome
        -String numero
        -Partido partido
        -byte[] foto
        -String nomeVice
        -String nomePrimeiroSuplente
        -String nomeSegundoSuplente
        +getters()
        +copiarComIdentificador(long novoIdentificador) FichaCandidato
    }

    class Montador {
        <<FichaCandidato.Montador>>
        +Montador(Cargo cargo)
        +definirIdentificador(long) Montador
        +definirNome(String) Montador
        +definirNumero(String) Montador
        +definirPartido(Partido) Montador
        +definirFoto(byte[]) Montador
        +definirNomeVice(String) Montador
        +definirNomesDosSuplentes(String, String) Montador
        +montar() FichaCandidato
    }

    class FabricaCandidato {
        +criar(FichaCandidato ficha)$ Candidato
    }

    Candidato <|-- CandidatoComVice
    Candidato <|-- CandidatoSenador
    Candidato <|-- CandidatoDeputado
    CandidatoComVice <|-- CandidatoPresidente
    CandidatoComVice <|-- CandidatoGovernador
    CandidatoDeputado <|-- CandidatoDeputadoFederal
    CandidatoDeputado <|-- CandidatoDeputadoEstadual
    Candidato "*" --> "1" Partido : pertence a
    Candidato ..> Cargo : getCargo
    FichaCandidato --> Cargo
    FichaCandidato --> Partido
    FichaCandidato *-- Montador : classe aninhada
    Montador ..> FichaCandidato : monta
    FabricaCandidato ..> FichaCandidato : lê
    FabricaCandidato ..> Candidato : cria
