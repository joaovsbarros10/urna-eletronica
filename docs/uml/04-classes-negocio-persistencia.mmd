%% Negócio, persistência, som e exceção.
classDiagram
    direction TB

    class FachadaUrna {
        -RepositorioUrna repositorio
        -List~Partido~ partidos
        -List~Candidato~ candidatos
        +carregarDados() void
        +iniciarSessao() SessaoVotacao
        +registrarVotos(List~Voto~) void
        +listarPartidos() List~Partido~
        +salvarPartido(Partido) void
        +excluirPartido(Partido) void
        +listarCandidatos() List~Candidato~
        +salvarCandidato(Candidato) void
        +excluirCandidato(Candidato) void
        +apurar(Cargo) ApuracaoCargo
    }

    class RepositorioUrna {
        <<interface>>
        +listarPartidos() List~Partido~
        +salvarPartido(Partido) Partido
        +excluirPartido(Partido) void
        +listarCandidatos() List~Candidato~
        +salvarCandidato(Candidato) Candidato
        +excluirCandidato(Candidato) void
        +gravarVotos(List~Voto~) void
        +listarVotos(Cargo, List~Candidato~) List~Voto~
    }

    class RepositorioUrnaSupabase {
        -ConexaoBancoDados conexaoBancoDados
    }
    class RepositorioUrnaMemoria {
        +criarComDadosDeDemonstracao()$ RepositorioUrnaMemoria
    }
    class ConexaoBancoDados {
        +carregar(String prefixo)$ ConexaoBancoDados
        +abrirConexao() Connection
    }
    class ReprodutorSom {
        +tocarTecla() void
        +tocarConfirmacao() void
        +tocarFim() void
    }
    class UrnaException

    FachadaUrna --> RepositorioUrna
    RepositorioUrna <|.. RepositorioUrnaSupabase
    RepositorioUrna <|.. RepositorioUrnaMemoria
    RepositorioUrnaSupabase --> ConexaoBancoDados
    FachadaUrna ..> UrnaException : lança
    RepositorioUrnaSupabase ..> UrnaException : lança
