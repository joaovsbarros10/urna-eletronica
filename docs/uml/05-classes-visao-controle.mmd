%% Visão (Swing) e controle.
classDiagram
    direction TB

    class JFrame {
        <<Swing>>
    }
    class JPanel {
        <<Swing>>
    }
    class JButton {
        <<Swing>>
    }

    class VisaoVotacao {
        <<interface>>
        +atualizar(SessaoVotacao) void
        +exibirCarregando() void
        +exibirErro(String) void
        +perguntarSeTentaNovamente(String) boolean
        +perguntarSeUsaDemonstracao() boolean
        +encerrar() void
    }

    class ControladorVotacao {
        -FachadaUrna fachada
        -ReprodutorSom som
        -SessaoVotacao sessao
        +iniciar() void
        +aoPressionarDigito(char) void
        +aoPressionarBranco() void
        +aoPressionarCorrige() void
        +aoPressionarConfirma() void
    }

    class ControladorAdministracao {
        -FachadaUrna fachada
    }

    class JanelaUrna
    class PainelDisplay {
        +atualizar(SessaoVotacao) void
    }
    class PainelTeclado
    class BotaoTecla
    class TemaVisual {
        <<interface>>
    }

    class JanelaAdministracao
    class PainelAdministrativo {
        <<abstract>>
        +getTitulo()* String
        +atualizar()* void
        #executarEmSegundoPlano(Callable, Consumer) void
    }
    class PainelCadastroPartido
    class PainelCadastroCandidato
    class PainelApuracao

    JFrame <|-- JanelaUrna
    JFrame <|-- JanelaAdministracao
    JPanel <|-- PainelDisplay
    JPanel <|-- PainelTeclado
    JPanel <|-- PainelAdministrativo
    JButton <|-- BotaoTecla
    VisaoVotacao <|.. JanelaUrna
    PainelAdministrativo <|-- PainelCadastroPartido
    PainelAdministrativo <|-- PainelCadastroCandidato
    PainelAdministrativo <|-- PainelApuracao
    JanelaUrna *-- PainelDisplay
    JanelaUrna *-- PainelTeclado
    PainelTeclado *-- "13" BotaoTecla
    JanelaAdministracao *-- "3" PainelAdministrativo
    ControladorVotacao --> VisaoVotacao
    BotaoTecla ..> ControladorVotacao : aciona
    PainelAdministrativo --> ControladorAdministracao
    PainelDisplay ..> TemaVisual
