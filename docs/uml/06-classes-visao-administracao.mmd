%% Visão e controle da administração (seção 5.4.2), conforme o código.
classDiagram
    direction TB

    class JFrame {
        <<Swing>>
    }
    class JPanel {
        <<Swing>>
    }
    class FachadaUrna {
        <<negocio>>
    }

    class JanelaAdministracao {
        -JTabbedPane abas
        -List~PainelAdministrativo~ paineis
        +JanelaAdministracao(ControladorAdministracao controlador)
        +adicionarPainel(PainelAdministrativo painel) void
        +atualizarPainelSelecionado() void
    }

    class PainelAdministrativo {
        <<abstract>>
        -ControladorAdministracao controlador
        #PainelAdministrativo(ControladorAdministracao controlador)
        #getControlador() ControladorAdministracao
        #exibirErro(String mensagem) void
        #exibirInformacao(String mensagem) void
        #confirmar(String pergunta) boolean
        #executarEmSegundoPlano(Callable tarefa, Consumer aoConcluir) void
        #converterNumero(String texto, String descricao)$ int
        +getTitulo()* String
        +atualizar()* void
    }

    class PainelCadastroPartido {
        -JTable tabelaPartidos
        -JTextField campoNumero
        -JTextField campoSigla
        -JTextField campoNome
        -Partido partidoSelecionado
        +getTitulo() String
        +atualizar() void
        -salvar() void
        -excluir() void
    }

    class PainelCadastroCandidato {
        -JComboBox~Cargo~ seletorCargo
        -JComboBox~Partido~ seletorPartido
        -JTextField campoNumero
        -JTextField campoNome
        -JTextField campoNomeVice
        -JTextField campoNomePrimeiroSuplente
        -JTextField campoNomeSegundoSuplente
        -JLabel rotuloPrevia
        -byte[] fotoEscolhida
        +getTitulo() String
        +atualizar() void
        -escolherFoto() void
        -reduzirFoto(BufferedImage original)$ byte[]
        -habilitarCamposDoCargo() void
        -salvar() void
        -excluir() void
    }

    class PainelApuracao {
        -JComboBox~Cargo~ seletorCargo
        -JTable tabelaResultados
        -JLabel rotuloResumo
        +getTitulo() String
        +atualizar() void
        -exibirApuracao(ApuracaoCargo apuracao) void
    }

    class ControladorAdministracao {
        -FachadaUrna fachada
        +ControladorAdministracao(FachadaUrna fachada)
        +carregarDadosEleitorais() void
        +listarPartidos() List~Partido~
        +salvarPartido(Partido partido) void
        +excluirPartido(Partido partido) void
        +listarCandidatos() List~Candidato~
        +salvarCandidato(FichaCandidato ficha) void
        +excluirCandidato(Candidato candidato) void
        +apurarVotos(Cargo cargo) ApuracaoCargo
    }

    JFrame <|-- JanelaAdministracao
    JPanel <|-- PainelAdministrativo
    PainelAdministrativo <|-- PainelCadastroPartido
    PainelAdministrativo <|-- PainelCadastroCandidato
    PainelAdministrativo <|-- PainelApuracao
    JanelaAdministracao "1" *-- "3" PainelAdministrativo
    JanelaAdministracao ..> ControladorAdministracao : repassa aos painéis
    PainelAdministrativo --> ControladorAdministracao
    ControladorAdministracao --> FachadaUrna
