%% Coleções do Firestore. Não há coleção de eleitor e voto não guarda horário (RN12).
%% O identificador de partido e candidato é o nome do documento; o do voto é aleatório.
erDiagram
    partido ||--o{ candidato : tem
    candidato |o--o{ voto : recebe

    partido {
        string identificador PK "nome do documento"
        int numero "10 a 99 (RN03)"
        string sigla
        string nome
    }

    candidato {
        string identificador PK "nome do documento"
        string cargo
        string numero "prefixo do partido (RN04)"
        string nome
        int partido FK "identificador do partido"
        bytes foto "até 200 KB (RN06)"
        array complementos "vice ou 2 suplentes (RN07)"
    }

    voto {
        string identificador PK "aleatório"
        string cargo
        string tipo "CANDIDATO, BRANCO ou NULO"
        int candidato FK "só em CANDIDATO"
    }
