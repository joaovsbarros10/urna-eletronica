%% Persistência, som e exceções (seção 5.4.4), conforme o código.
classDiagram
    direction TB

    class RepositorioPartido {
        <<interface>>
        +listarTodos() List~Partido~
        +salvar(Partido partido) Partido
        +excluir(Partido partido) void
    }

    class RepositorioCandidato {
        <<interface>>
        +listarTodos() List~Candidato~
        +salvar(Candidato candidato) Candidato
        +excluir(Candidato candidato) void
    }

    class RepositorioVoto {
        <<interface>>
        +gravarTodos(List~Voto~ votos) void
        +listarPorCargo(Cargo cargo) List~Voto~
    }

    class ConfiguracaoSupabase {
        +String ARQUIVOPROPRIEDADES$
        -String enderecoConexao
        -String usuario
        -String senha
        +carregar()$ ConfiguracaoSupabase
        +carregarAdministracao()$ ConfiguracaoSupabase
        +getEnderecoConexao() String
        +getUsuario() String
        +getSenha() String
    }

    class ConexaoBancoDados {
        -ConfiguracaoSupabase configuracao
        +ConexaoBancoDados(ConfiguracaoSupabase configuracao)
        +abrirConexao() Connection
    }

    class TradutorErroBanco {
        ~traduzir(SQLException erro, String acao)$ PersistenciaException
    }

    class RepositorioPartidoSupabase {
        -ConexaoBancoDados conexaoBancoDados
    }
    class RepositorioCandidatoSupabase {
        -ConexaoBancoDados conexaoBancoDados
    }
    class RepositorioVotoSupabase {
        -ConexaoBancoDados conexaoBancoDados
        -RepositorioCandidato repositorioCandidato
    }
    class RepositorioPartidoMemoria {
        -List~Partido~ partidos
    }
    class RepositorioCandidatoMemoria {
        -List~Candidato~ candidatos
    }
    class RepositorioVotoMemoria {
        -List~Voto~ votos
        +contarVotos() int
    }
    class CargaDemonstracao {
        +preencher(RepositorioPartido, RepositorioCandidato)$ void
        +desenharFoto(String nome, Color cor)$ byte[]
    }

    class EfeitoSonoro {
        <<enumeration>>
        TECLA
        CONFIRMACAO
        FIM
        -int frequenciaEmHertz
        -int duracaoEmMilissegundos
        +getFrequenciaEmHertz() int
        +getDuracaoEmMilissegundos() int
    }

    class ReprodutorSom {
        <<interface>>
        +reproduzir(EfeitoSonoro efeito) void
    }

    class ReprodutorSomJavaSound {
        -Map~EfeitoSonoro,byte[]~ amostrasPorEfeito
        -ExecutorService executor
        -SourceDataLine linha
        +estaDisponivel()$ boolean
        +reproduzir(EfeitoSonoro efeito) void
        -sintetizar(EfeitoSonoro efeito) byte[]
        -tocar(byte[] amostras) void
    }

    class ReprodutorSomMudo {
        +reproduzir(EfeitoSonoro efeito) void
    }

    class UrnaException {
        <<abstract>>
        #UrnaException(String mensagem)
        #UrnaException(String mensagem, Throwable causa)
    }
    class RuntimeException {
        <<JDK>>
    }
    class PersistenciaException
    class RegraNegocioException
    class ConfiguracaoException

    RepositorioPartido <|.. RepositorioPartidoSupabase
    RepositorioPartido <|.. RepositorioPartidoMemoria
    RepositorioCandidato <|.. RepositorioCandidatoSupabase
    RepositorioCandidato <|.. RepositorioCandidatoMemoria
    RepositorioVoto <|.. RepositorioVotoSupabase
    RepositorioVoto <|.. RepositorioVotoMemoria
    RepositorioPartidoSupabase --> ConexaoBancoDados
    RepositorioCandidatoSupabase --> ConexaoBancoDados
    RepositorioVotoSupabase --> ConexaoBancoDados
    RepositorioVotoSupabase --> RepositorioCandidato
    RepositorioPartidoSupabase ..> TradutorErroBanco
    RepositorioCandidatoSupabase ..> TradutorErroBanco
    RepositorioVotoSupabase ..> TradutorErroBanco
    ConexaoBancoDados --> ConfiguracaoSupabase
    CargaDemonstracao ..> RepositorioPartido : preenche
    CargaDemonstracao ..> RepositorioCandidato : preenche
    ReprodutorSom <|.. ReprodutorSomJavaSound
    ReprodutorSom <|.. ReprodutorSomMudo
    ReprodutorSom ..> EfeitoSonoro
    RuntimeException <|-- UrnaException
    UrnaException <|-- PersistenciaException
    UrnaException <|-- RegraNegocioException
    UrnaException <|-- ConfiguracaoException
