%% Confirmar o último cargo e gravar os votos (seção 5.5.2), conforme o código.
sequenceDiagram
    autonumber
    actor Eleitor
    participant Botao as BotaoConfirma
    participant Controlador as ControladorVotacao
    participant Som as ReprodutorSom
    participant Sessao as SessaoVotacao
    participant Janela as JanelaUrna
    participant Tarefa as SwingWorker
    participant Fachada as FachadaUrna
    participant Servico as ServicoVotacao
    participant Repositorio as RepositorioVotoSupabase
    participant Banco as Supabase

    Eleitor->>Botao: clica em CONFIRMA no 5º cargo
    Botao->>Controlador: aoPressionarConfirma()
    Controlador->>Sessao: confirmar()
    Sessao->>Janela: aoAtualizarSessao(sessao) com EstadoEncerrado e aviso FIM
    Sessao-->>Controlador: true (voto aceito)
    Controlador-)Som: reproduzir(FIM)
    Controlador->>Controlador: gravacaoPendente = true
    Controlador->>Tarefa: gravarVotos() em segundo plano
    Tarefa->>Fachada: registrarVotos(votos)
    Fachada->>Servico: registrarVotos(votos)
    Servico->>Servico: confere um voto por cargo (RN10)
    Servico->>Repositorio: gravarTodos(votos)
    Repositorio->>Banco: transação com 5 INSERTs em lote
    alt gravou
        Banco-->>Repositorio: COMMIT
        Tarefa-->>Controlador: concluído, na thread de eventos
        Controlador->>Controlador: gravacaoPendente = false; Timer de 3 s → iniciarNovaSessao()
        Controlador->>Janela: aoAtualizarSessao(novaSessao)
    else falhou
        Banco-->>Repositorio: erro
        Repositorio-->>Tarefa: PersistenciaException após ROLLBACK
        Tarefa-->>Controlador: falha, na thread de eventos
        Controlador->>Janela: perguntarSeTentaNovamente(mensagem)
        alt aceita tentar de novo
            Controlador->>Tarefa: gravarVotos() com os mesmos votos
        else recusa
            Controlador->>Janela: exibirErro("Aperte CONFIRMA para tentar gravar de novo")
            Note over Controlador,Sessao: os votos ficam em sessaoAtual (RNF09);<br/>CONFIRMA na tela FIM refaz a gravação
        end
    end
