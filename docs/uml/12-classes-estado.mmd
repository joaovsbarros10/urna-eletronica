%% Classes do padrão State (seção 5.6.3), conforme o código. "~" = acesso de pacote.
classDiagram
    direction TB

    class OuvinteSessaoVotacao {
        <<interface>>
        +aoAtualizarSessao(SessaoVotacao sessao) void
    }

    class CatalogoCandidatos {
        <<interface>>
        +buscarCandidato(Cargo cargo, String numero) Optional~Candidato~
        +existePartidoComNumero(int numero) boolean
    }

    class SessaoVotacao {
        -List~Cargo~ cargosNaOrdem
        -CatalogoCandidatos catalogo
        -StringBuilder digitosDigitados
        -List~Voto~ votosRegistrados
        -List~OuvinteSessaoVotacao~ ouvintes
        -int posicaoDoCargo
        -Candidato candidatoEncontrado
        -EstadoSessao estadoAtual
        +SessaoVotacao(CatalogoCandidatos catalogo)
        +adicionarOuvinte(OuvinteSessaoVotacao ouvinte) void
        +removerOuvinte(OuvinteSessaoVotacao ouvinte) void
        +digitar(char digito) void
        +corrigir() void
        +votarEmBranco() void
        +confirmar() boolean
        +getCargoAtual() Cargo
        +getDigitosDigitados() String
        +getCandidatoEncontrado() Optional~Candidato~
        +getAvisoPrincipal() String
        +permiteConfirmar() boolean
        +getVotosRegistrados() List~Voto~
        +estaEncerrada() boolean
        ~acrescentarDigito(char digito) void
        ~limparDigitos() void
        ~estaComNumeroCompleto() boolean
        ~estaSemDigitos() boolean
        ~definirEstado(EstadoSessao estado) void
        ~definirCandidatoEncontrado(Candidato candidato) void
        ~getCatalogo() CatalogoCandidatos
        ~registrarVoto(Voto voto) void
        ~existeProximoCargo() boolean
        ~avancarParaProximoCargo() void
        -notificarOuvintes() void
    }

    class EstadoSessao {
        <<interface>>
        +digitar(SessaoVotacao sessao, char digito) void
        +corrigir(SessaoVotacao sessao) void
        +votarEmBranco(SessaoVotacao sessao) void
        +confirmar(SessaoVotacao sessao) boolean
        +permiteConfirmar() boolean
        +getAvisoPrincipal() String
    }

    class EstadoDigitando {
        +digitar(SessaoVotacao sessao, char digito) void
        +corrigir(SessaoVotacao sessao) void
        +votarEmBranco(SessaoVotacao sessao) void
        +confirmar(SessaoVotacao sessao) boolean
        +permiteConfirmar() boolean
        +getAvisoPrincipal() String
        -decidirVoto(SessaoVotacao sessao) void
    }

    class EstadoConfirmavel {
        <<abstract>>
        +digitar(SessaoVotacao sessao, char digito) void
        +corrigir(SessaoVotacao sessao) void
        +votarEmBranco(SessaoVotacao sessao) void
        +confirmar(SessaoVotacao sessao) boolean
        +permiteConfirmar() boolean
        #criarVoto(SessaoVotacao sessao)* Voto
    }

    class EstadoCandidatoEncontrado {
        -Candidato candidato
        #criarVoto(SessaoVotacao sessao) Voto
        +getAvisoPrincipal() String
    }

    class EstadoNumeroInexistente {
        ~String NUMEROERRADO$
        ~String CANDIDATOINEXISTENTE$
        ~String VOTONULO$
        -String aviso
        #criarVoto(SessaoVotacao sessao) Voto
        +getAvisoPrincipal() String
    }

    class EstadoVotoEmBranco {
        ~String VOTOEMBRANCO$
        #criarVoto(SessaoVotacao sessao) Voto
        +getAvisoPrincipal() String
    }

    class EstadoEncerrado {
        ~String FIM$
        +digitar(SessaoVotacao sessao, char digito) void
        +corrigir(SessaoVotacao sessao) void
        +votarEmBranco(SessaoVotacao sessao) void
        +confirmar(SessaoVotacao sessao) boolean
        +permiteConfirmar() boolean
        +getAvisoPrincipal() String
    }

    SessaoVotacao o-- EstadoSessao : estadoAtual
    SessaoVotacao "1" o-- "*" OuvinteSessaoVotacao
    SessaoVotacao "1" o-- "0..5" Voto
    SessaoVotacao --> CatalogoCandidatos
    EstadoSessao <|.. EstadoDigitando
    EstadoSessao <|.. EstadoConfirmavel
    EstadoSessao <|.. EstadoEncerrado
    EstadoConfirmavel <|-- EstadoCandidatoEncontrado
    EstadoConfirmavel <|-- EstadoNumeroInexistente
    EstadoConfirmavel <|-- EstadoVotoEmBranco
    EstadoSessao ..> SessaoVotacao : age sobre
