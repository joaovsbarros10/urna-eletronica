# Urna Eletrônica - modelo do arquivo de configuração local (RNF07).
#
# Copie este arquivo para "urna.propriedades" na pasta de onde a urna é aberta
# e preencha. O arquivo urna.propriedades está no .gitignore: nunca o versione.
# As variáveis de ambiente de mesmo nome têm prioridade sobre este arquivo.

# Console do Firebase > Configurações do projeto > Geral > "Código do projeto".
URNA_FIREBASE_PROJETO=<codigo-do-projeto>

# Login (opcional). Sem estas linhas a urna acessa o Firestore sem login e
# vale banco/firestore.rules. Com elas, publique banco/firestore-com-login.rules.
# URNA_FIREBASE_CHAVE=<chave-de-api-da-web>
# URNA_BANCO_EMAIL=votacao@urna.test
# URNA_BANCO_SENHA=<senha-do-usuario-votacao>
# URNA_ADMIN_BANCO_EMAIL=administracao@urna.test
# URNA_ADMIN_BANCO_SENHA=<senha-do-usuario-administracao>
